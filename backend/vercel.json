{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm install",
    "installCommand": "npm install",
    "builds": [
        {
            "src": "api/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "api/index.ts"
        }
    ]
}